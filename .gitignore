# ============================================
# Velvet Vogue - Git Ignore Rules
# ============================================

# Environment & Config (sensitive credentials)
config/db.php

# Uploaded user files (large binary assets)
uploads/*
!uploads/.gitkeep

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDE / Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Logs
*.log
logs/

# PHP compiled / cache files
*.php~
.phpunit.result.cache

# Node modules (if any tooling is added later)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Composer (if added later)
vendor/
composer.lock

# Temporary files
*.tmp
*.temp
*.bak
*.orig
